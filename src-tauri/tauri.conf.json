{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ringtone",
  "version": "0.2.0",
  "identifier": "cn.ringtone.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ringtone",
        "width": 460,
        "height": 720,
        "minWidth": 400,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "shadow": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
